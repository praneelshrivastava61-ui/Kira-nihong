
<!DOCTYPE html>
<html>
<head>
<title>Star Clicker</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body {
  background: linear-gradient(135deg,#101044,#42166b);
  color: white;
  text-align: center;
  font-family: Arial;
}
h1 { color: gold; }
#score { font-size: 25px; }
#star {
  font-size: 75px;
  position: absolute;
  cursor: pointer;
  user-select: none;
  display: none;
}
button {
  padding: 14px 30px;
  background: gold;
  border: none;
  border-radius: 10px;
  font-size: 18px;
  cursor: pointer;
}
</style>
</head>
<body>

<h1>⭐ STAR CLICKER ⭐</h1>
<p id="score">Score: 0</p>
<p id="timer">Time: 30</p>

<button onclick="startGame()">START GAME</button>

<div id="star" onclick="clickStar()">⭐</div>

<script>
let score = 0;
let time = 30;
let playing = false;
let timer;

const star = document.getElementById("star");

function moveStar() {
  star.style.left =
    Math.random() * (window.innerWidth - 90) + "px";

  star.style.top =
    (Math.random() * (window.innerHeight - 180) + 100) + "px";
}

function startGame() {
  score = 0;
  time = 30;
  playing = true;

  document.getElementById("score").innerText = "Score: 0";
  document.getElementById("timer").innerText = "Time: 30";

  star.style.display = "block";
  moveStar();

  clearInterval(timer);

  timer = setInterval(() => {
    time--;
    document.getElementById("timer").innerText =
      "Time: " + time;

    if (time <= 0) {
      clearInterval(timer);
      playing = false;
      star.style.display = "none";
      alert("Game Over! Your score: " + score);
    }
  }, 1000);
}

function clickStar() {
  if (!playing) return;

  score++;
  document.getElementById("score").innerText =
    "Score: " + score;

  moveStar();
}
</script>

</body>
</html>
